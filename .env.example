# ===== AI ASSISTANT CONFIGURATION =====

# Your name (used by the Telegram bot's system prompts and responses)
USER_NAME=YourName

# Telegram API credentials
# 1. Message @BotFather on Telegram to create a bot and get a BOT_TOKEN
# 2. Message @userinfobot or @RawDataBot to find your personal CHAT_ID
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Local LLM Config (Ollama)
# Default localhost URL for Ollama container
OLLAMA_URL=http://localhost:11434/api/chat

# LLM model used for job description parsing and scoring (Logic tasks)
OLLAMA_MODEL=qwen3:4b

# LLM model used for conversational personal assistance (Chat tasks)
OLLAMA_BOT_MODEL=qwen3:fast

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Cache directory for deduplication (default: jobs_cache/)
# CACHE_DIR=jobs_cache

